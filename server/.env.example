NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/slawatch?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
CLIENT_ORIGIN=http://localhost:5173
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=CHOOSE_A_STRONG_DEMO_PASSWORD
SEED_MANAGER_NAME=Demo Manager
# OPTIONAL: Only set this on a disposable local/Atlas development database.
ALLOW_DEMO_SEED=no
SEED_DEMO_AGENT_PASSWORD=CHOOSE_A_SEPARATE_STRONG_DEMO_PASSWORD
